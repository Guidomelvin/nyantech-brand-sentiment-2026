# Environment & Secrets (NEVER commit .env)
.env
.env.*
!.env.example
*.pem
*.key
client_secret*.json

# Python virtual environments & caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Data artifacts (raw scrapes, processed parquet/csv, checkpoints)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/outputs/*
!data/outputs/.gitkeep

# Logs & temporary files
logs/
*.log
.DS_Store
Thumbs.db
