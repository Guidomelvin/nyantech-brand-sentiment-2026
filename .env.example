# ==============================================================================
# NYANTECH Brand Sentiment 2026 - Environment Variables Template
# Salin file ini menjadi `.env` lalu isi API key Anda.
# JANGAN PERNAH commit atau push file `.env` ke GitHub!
# ==============================================================================

# [WAJIB - Tahap 1] YouTube Data API v3 Key (Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# [OPSIONAL - Tahap 1] Target Channel YouTube (default: @NYANTECH)
YOUTUBE_CHANNEL_HANDLE=@NYANTECH
# Isi Channel ID langsung jika sudah diketahui untuk menghemat 1x API call lookup
YOUTUBE_CHANNEL_ID=

# [OPSIONAL - Tahap 2 & 3] LLM API Key untuk hybrid extraction / sentiment refinement
# Mendukung OpenAI-compatible endpoint (OpenAI, Groq, Together, OpenRouter, dll.) atau Gemini
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
